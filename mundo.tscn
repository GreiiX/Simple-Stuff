[sub_resource type="Shader" id="Shader_otwa2"]
code = "
	shader_type spatial;
	render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_burley, specular_schlick_ggx;
	uniform vec4 color_hondo : source_color = vec4(0.055,0.26,0.34,1.0);
	uniform vec4 color_somero : source_color = vec4(0.30,0.64,0.66,1.0);
	uniform vec4 color_espuma : source_color = vec4(0.97,0.97,0.91,1.0);
	uniform float velocidad = 0.30;
	uniform float escala = 0.05;
	uniform float altura_ola = 0.0;
	uniform float transparencia = 1.0;
	uniform float metalico = 0.12;
	uniform float deriva = 0.0;
	varying vec3 mundo;
	float onda(vec2 p, float t){
		float a = sin(p.x*1.7 + t*1.1)*cos(p.y*1.3 - t*0.8);
		float b = sin((p.x+p.y)*2.3 - t*1.7)*0.5;
		float c = sin(p.y*3.1 + t*2.3)*0.25;
		return (a+b+c)/1.75;
	}
	void vertex(){
		mundo = (MODEL_MATRIX*vec4(VERTEX,1.0)).xyz;
		if (altura_ola > 0.001) { VERTEX.y += onda(mundo.xz*escala, TIME*velocidad)*altura_ola; }
	}
	void fragment(){
		float t = TIME*velocidad;
		vec2 p = mundo.xz*escala + vec2(0.0, -TIME*deriva);
		float e = 0.35;
		float h = onda(p,t);
		float hx = onda(p+vec2(e,0.0),t);
		float hy = onda(p+vec2(0.0,e),t);
		vec3 n = normalize(vec3(-(hx-h)*2.4, 1.0, -(hy-h)*2.4));
		NORMAL = normalize((VIEW_MATRIX*vec4(n,0.0)).xyz);
		vec3 col = mix(color_hondo.rgb, color_somero.rgb, clamp(h*0.5+0.5,0.0,1.0));
		float cresta = smoothstep(0.70,0.95,h);
		col = mix(col, color_espuma.rgb, cresta*0.7);
		ALBEDO = col; ROUGHNESS = 0.05+cresta*0.3; METALLIC = metalico;
		SPECULAR = 0.7; ALPHA = transparencia;
	}
	"

